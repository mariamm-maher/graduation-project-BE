{
  "openapi": "3.0.0",
  "info": {
    "title": "Node.js Backend API",
    "description": "API Documentation for the Campaign Management & Collaboration Platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "error" },
          "message": { "type": "string", "example": "Something went wrong" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string" }
        }
      },
      "Campaign": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "campaignName": { "type": "string" },
          "UserDescription": { "type": "string" },
          "goalType": { "type": "string" },
          "totalBudget": { "type": "number" },
          "currency": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "active", "completed", "paused"] },
          "startDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ServiceListing": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number" },
          "category": { "type": "string" }
        }
      },
      "Offer": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "serviceRequestId": { "type": "integer" },
          "influencerId": { "type": "integer" },
          "price": { "type": "number" },
          "message": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] }
        }
      },
      "CollaborationRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "campaignId": { "type": "integer" },
          "ownerId": { "type": "integer" },
          "influencerId": { "type": "integer" },
          "status": {
            "type": "string",
            "enum": ["pending", "negotiating", "accepted", "rejected", "cancelled", "expired"]
          },
          "proposedBudget": { "type": "number", "example": 1500.00 },
          "counterPrice": { "type": "number", "example": 1800.00 },
          "message": { "type": "string" },
          "responseMessage": { "type": "string" },
          "lastCounteredBy": { "type": "integer" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Collaboration": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "collaborationRequestId": { "type": "integer" },
          "campaignId": { "type": "integer" },
          "ownerId": { "type": "integer" },
          "influencerId": { "type": "integer" },
          "status": {
            "type": "string",
            "enum": ["PendingContractSign", "live", "InProgress", "completed", "cancelled"]
          },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "completedAt": { "type": "string", "format": "date-time" },
          "cancelledAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CollaborationContract": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "collaborationId": { "type": "integer" },
          "agreedPrice": { "type": "number", "example": 1500.00 },
          "currency": { "type": "string", "example": "USD" },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "example": "Instagram Post" },
                "description": { "type": "string", "example": "Lifestyle photo featuring the product" },
                "platform": { "type": "string", "example": "instagram" },
                "contentType": { "type": "string", "example": "post" },
                "dueDate": { "type": "string", "format": "date", "example": "2024-03-15" }
              }
            }
          },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "revisionLimit": { "type": "integer", "example": 2 },
          "status": { "type": "string", "enum": ["draft", "sent", "signed"] },
          "contractRef": { "type": "string", "example": "CONT-2024-12345" },
          "notes": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CollaborationTask": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "collaborationId": { "type": "integer" },
          "taskName": { "type": "string" },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["todo", "in_progress", "in_review", "Approved", "rejected"]
          },
          "platform": {
            "type": "string",
            "enum": ["instagram", "tiktok", "youtube", "facebook", "twitter", "linkedin", "snapchat", "whatsapp", "other"]
          },
          "contentType": {
            "type": "string",
            "enum": ["post", "story", "reel", "video", "carousel", "article", "tweet", "poll"]
          },
          "dueDate": { "type": "string", "format": "date" },
          "submissionUrl": { "type": "string" },
          "submissionNote": { "type": "string" },
          "submittedAt": { "type": "string", "format": "date-time" },
          "reviewNote": { "type": "string" },
          "revisionCount": { "type": "integer" },
          "sortOrder": { "type": "integer" },
          "completedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "tags": [
    { "name": "Auth", "description": "Authentication and User Management" },
    { "name": "Campaigns", "description": "Campaign Management and AI Generation" },
    { "name": "Collaboration Requests", "description": "Brand sends invite → Influencer accepts/rejects/counters" },
    { "name": "Collaborations", "description": "Active collaborations — contract + task board management" },
    { "name": "Contracts", "description": "Contract lifecycle: draft → sent → signed" },
    { "name": "Tasks", "description": "Task board — influencer submits, owner reviews" },
    { "name": "Marketplace", "description": "Service Marketplace" }
  ],
  "paths": {

    "/api/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["firstName", "lastName", "email", "password"],
                "properties": {
                  "firstName": { "type": "string", "example": "John" },
                  "lastName": { "type": "string", "example": "Doe" },
                  "email": { "type": "string", "format": "email", "example": "john@example.com" },
                  "password": { "type": "string", "example": "SecurePass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully" },
          "400": { "description": "Validation error or email already in use" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "User Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "john@example.com" },
                  "password": { "type": "string", "example": "SecurePass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns accessToken" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/select-role": {
      "post": {
        "tags": ["Auth"],
        "summary": "Select/Assign User Role",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["userId", "roleId"],
                "properties": {
                  "userId": { "type": "integer", "example": 1 },
                  "roleId": { "type": "integer", "example": 2 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Role assigned successfully" },
          "400": { "description": "Invalid input" },
          "404": { "description": "User or Role not found" }
        }
      }
    },
    "/api/auth/refresh-token": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh Access Token",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "New access token returned" },
          "401": { "description": "Invalid or expired refresh token" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/api/auth/logout-all": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout All Devices",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out from all devices" }
        }
      }
    },
    "/api/auth/sessions": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get Active Sessions",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of active sessions" }
        }
      }
    },
    "/api/auth/sessions/{sessionId}": {
      "delete": {
        "tags": ["Auth"],
        "summary": "Revoke Session",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Session revoked" },
          "404": { "description": "Session not found" }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "tags": ["Auth"],
        "summary": "Initiate Google OAuth",
        "responses": { "302": { "description": "Redirects to Google" } }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "Google OAuth Callback",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Authentication successful" },
          "401": { "description": "Authentication failed" }
        }
      }
    },

    "/api/campaigns": {
      "get": {
        "tags": ["Campaigns"],
        "summary": "Get All Campaigns",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of campaigns",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Campaign" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/campaigns/create": {
      "post": {
        "tags": ["Campaigns"],
        "summary": "Create Campaign & Generate AI Preview",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["campaignName", "userDescription", "goalType", "totalBudget", "currency", "startDate", "endDate"],
                "properties": {
                  "campaignName": { "type": "string", "example": "Summer Fashion Launch" },
                  "userDescription": { "type": "string", "example": "A marketing campaign for our new summer clothing line." },
                  "goalType": { "type": "string", "example": "Brand Awareness" },
                  "totalBudget": { "type": "number", "example": 5000 },
                  "currency": { "type": "string", "example": "USD" },
                  "startDate": { "type": "string", "format": "date", "example": "2024-06-01" },
                  "endDate": { "type": "string", "format": "date", "example": "2024-08-31" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Campaign created and AI preview generated" },
          "400": { "description": "Validation error" }
        }
      }
    },

    "/api/collaborations/requests": {
      "post": {
        "tags": ["Collaboration Requests"],
        "summary": "Send collaboration invite to influencer",
        "description": "Brand (owner) sends a collaboration request to an influencer for a campaign.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["campaignId", "influencerId"],
                "properties": {
                  "campaignId": { "type": "integer", "example": 1 },
                  "influencerId": { "type": "integer", "example": 5 },
                  "proposedBudget": { "type": "number", "example": 1500.00 },
                  "message": { "type": "string", "example": "Hi! We'd love to work with you on our summer campaign." },
                  "expiresAt": { "type": "string", "format": "date-time", "example": "2024-04-01T00:00:00Z" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Collaboration request sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Collaboration request sent" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "request": { "$ref": "#/components/schemas/CollaborationRequest" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Active request already exists for this influencer on this campaign" },
          "401": { "description": "Unauthorized" }
        }
      },
      "get": {
        "tags": ["Collaboration Requests"],
        "summary": "List requests for a campaign (owner)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "campaignId", "in": "query", "required": true, "schema": { "type": "integer" }, "example": 1 },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["pending", "negotiating", "accepted", "rejected", "cancelled", "expired"] } }
        ],
        "responses": {
          "200": { "description": "List of collaboration requests for the campaign" }
        }
      }
    },

    "/api/collaborations/requests/mine/sent": {
      "get": {
        "tags": ["Collaboration Requests"],
        "summary": "Get all requests I sent (owner)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["pending", "negotiating", "accepted", "rejected", "cancelled", "expired"] } }
        ],
        "responses": {
          "200": { "description": "List of sent requests" }
        }
      }
    },

    "/api/collaborations/requests/mine/received": {
      "get": {
        "tags": ["Collaboration Requests"],
        "summary": "Get all requests I received (influencer)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["pending", "negotiating", "accepted", "rejected", "cancelled", "expired"] } }
        ],
        "responses": {
          "200": { "description": "List of received requests" }
        }
      }
    },

    "/api/collaborations/requests/{id}": {
      "get": {
        "tags": ["Collaboration Requests"],
        "summary": "Get a single collaboration request",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Collaboration request details" },
          "404": { "description": "Request not found" }
        }
      }
    },

    "/api/collaborations/requests/{id}/respond": {
      "patch": {
        "tags": ["Collaboration Requests"],
        "summary": "Respond to a collaboration request",
        "description": "**Influencer** responds when status is `pending`. **Owner** responds when status is `negotiating`.\n\n| Action | Who | Result |\n|--------|-----|--------|\n| `accept` | Influencer (pending) or Owner (negotiating) | Creates Collaboration |\n| `reject` | Influencer (pending) or Owner (negotiating) | Terminates request |\n| `counter` | Influencer (pending) → Owner's turn / Owner (negotiating) → Influencer's turn | Budget negotiation |",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["accept", "reject", "counter"],
                    "example": "counter"
                  },
                  "newBudget": {
                    "type": "number",
                    "description": "Required when action is 'counter'",
                    "example": 1800.00
                  },
                  "responseMessage": {
                    "type": "string",
                    "example": "I can do it for $1800 instead."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request updated. If accepted, a Collaboration is also created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "request": { "$ref": "#/components/schemas/CollaborationRequest" },
                        "collaboration": { "$ref": "#/components/schemas/Collaboration", "description": "Only present when action is 'accept'" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid action or wrong turn" },
          "403": { "description": "Not your turn to respond" },
          "404": { "description": "Request not found" }
        }
      }
    },

    "/api/collaborations/requests/{id}/cancel": {
      "patch": {
        "tags": ["Collaboration Requests"],
        "summary": "Cancel a collaboration request (owner only)",
        "description": "Owner can cancel while status is `pending` or `negotiating`.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Request cancelled" },
          "400": { "description": "Request is already in a terminal state" },
          "403": { "description": "Only the owner can cancel" },
          "404": { "description": "Request not found" }
        }
      }
    },

    "/api/collaborations/mine/owner": {
      "get": {
        "tags": ["Collaborations"],
        "summary": "List my collaborations as owner",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PendingContractSign", "live", "InProgress", "completed", "cancelled"] } }
        ],
        "responses": {
          "200": { "description": "List of collaborations where I am the brand" }
        }
      }
    },

    "/api/collaborations/mine/influencer": {
      "get": {
        "tags": ["Collaborations"],
        "summary": "List my collaborations as influencer",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PendingContractSign", "live", "InProgress", "completed", "cancelled"] } }
        ],
        "responses": {
          "200": { "description": "List of collaborations where I am the influencer" }
        }
      }
    },

    "/api/collaborations/{id}": {
      "get": {
        "tags": ["Collaborations"],
        "summary": "Get a single collaboration",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": {
            "description": "Collaboration details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "collaboration": { "$ref": "#/components/schemas/Collaboration" }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Collaboration not found" }
        }
      }
    },

    "/api/collaborations/{id}/cancel": {
      "patch": {
        "tags": ["Collaborations"],
        "summary": "Cancel a collaboration (owner only)",
        "description": "Owner can cancel from any non-terminal status.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Collaboration cancelled" },
          "403": { "description": "Only the owner can cancel" },
          "404": { "description": "Collaboration not found" }
        }
      }
    },

    "/api/collaborations/{id}/complete": {
      "patch": {
        "tags": ["Collaborations"],
        "summary": "Mark collaboration as completed (owner only)",
        "description": "All tasks must be `Approved` before this can be called.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Collaboration marked as completed" },
          "400": { "description": "Not all tasks are approved yet" },
          "403": { "description": "Only the owner can complete a collaboration" },
          "404": { "description": "Collaboration not found" }
        }
      }
    },

    "/api/collaborations/{collaborationId}/contract": {
      "post": {
        "tags": ["Contracts"],
        "summary": "Create a draft contract (owner only)",
        "description": "Owner creates a contract for a collaboration in `PendingContractSign` status. Deliverables will become tasks when the influencer signs.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "collaborationId", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["agreedPrice", "deliverables"],
                "properties": {
                  "agreedPrice": { "type": "number", "example": 1500.00 },
                  "currency": { "type": "string", "example": "USD" },
                  "startDate": { "type": "string", "format": "date", "example": "2024-03-01" },
                  "endDate": { "type": "string", "format": "date", "example": "2024-04-01" },
                  "notes": { "type": "string", "example": "Content must be approved before posting." },
                  "deliverables": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["title"],
                      "properties": {
                        "title": { "type": "string", "example": "Instagram Post — Product Reveal" },
                        "description": { "type": "string", "example": "Lifestyle photo with brand hashtag" },
                        "platform": { "type": "string", "example": "instagram" },
                        "contentType": { "type": "string", "example": "post" },
                        "dueDate": { "type": "string", "format": "date", "example": "2024-03-20" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft contract created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "contract": { "$ref": "#/components/schemas/CollaborationContract" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Contract already exists or invalid data" },
          "403": { "description": "Only the owner can create a contract" },
          "404": { "description": "Collaboration not found" }
        }
      },
      "get": {
        "tags": ["Contracts"],
        "summary": "Get contract for a collaboration",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "collaborationId", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Contract details" },
          "403": { "description": "Unauthorized — not a participant" },
          "404": { "description": "No contract exists yet" }
        }
      }
    },

    "/api/collaborations/contracts/{id}": {
      "patch": {
        "tags": ["Contracts"],
        "summary": "Update a draft contract (owner only)",
        "description": "Only allowed while contract status is `draft`.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agreedPrice": { "type": "number", "example": 1600.00 },
                  "startDate": { "type": "string", "format": "date" },
                  "endDate": { "type": "string", "format": "date" },
                  "deliverables": {
                    "type": "array",
                    "items": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Contract updated" },
          "400": { "description": "Only draft contracts can be updated" },
          "403": { "description": "Only the owner can update a contract" },
          "404": { "description": "Contract not found" }
        }
      }
    },

    "/api/collaborations/contracts/{id}/send": {
      "patch": {
        "tags": ["Contracts"],
        "summary": "Send contract to influencer (owner only)",
        "description": "Moves contract from `draft` → `sent`. Influencer can now sign.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Contract sent to influencer" },
          "400": { "description": "Only draft contracts can be sent" },
          "403": { "description": "Only the owner can send a contract" },
          "404": { "description": "Contract not found" }
        }
      }
    },

    "/api/collaborations/contracts/{id}/sign": {
      "patch": {
        "tags": ["Contracts"],
        "summary": "Sign the contract (influencer only)",
        "description": "Signs the contract → status becomes `signed` → collaboration moves to `live` → tasks auto-created from deliverables → chat room opened.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": {
            "description": "Contract signed. Returns contract, collaboration, chatRoom, and auto-created tasks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "contract": { "$ref": "#/components/schemas/CollaborationContract" },
                        "collaboration": { "$ref": "#/components/schemas/Collaboration" },
                        "chatRoom": { "type": "object" },
                        "tasks": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/CollaborationTask" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Only sent contracts can be signed" },
          "403": { "description": "Only the influencer can sign" },
          "404": { "description": "Contract not found" }
        }
      }
    },

    "/api/collaborations/{collaborationId}/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task board for a collaboration",
        "description": "Returns all tasks sorted by sortOrder. Use this to render the kanban board.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "collaborationId", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "tasks": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/CollaborationTask" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": { "description": "Not a participant in this collaboration" },
          "404": { "description": "Collaboration not found" }
        }
      }
    },

    "/api/collaborations/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get a single task",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Task details" },
          "404": { "description": "Task not found" }
        }
      },
      "patch": {
        "tags": ["Tasks"],
        "summary": "Update a task (owner only)",
        "description": "Owner can edit taskName, description, platform, contentType, dueDate, sortOrder.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "taskName": { "type": "string", "example": "Instagram Post — Updated Title" },
                  "description": { "type": "string" },
                  "platform": { "type": "string", "enum": ["instagram", "tiktok", "youtube", "facebook", "twitter", "linkedin", "snapchat", "whatsapp", "other"] },
                  "contentType": { "type": "string", "enum": ["post", "story", "reel", "video", "carousel", "article", "tweet", "poll"] },
                  "dueDate": { "type": "string", "format": "date" },
                  "sortOrder": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Task updated" },
          "403": { "description": "Only the owner can edit tasks" },
          "404": { "description": "Task not found" }
        }
      }
    },

    "/api/collaborations/tasks/{id}/start": {
      "patch": {
        "tags": ["Tasks"],
        "summary": "Start a task (influencer only)",
        "description": "Moves task from `todo` → `in_progress`.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Task started" },
          "400": { "description": "Task cannot be started from its current status" },
          "403": { "description": "Only the influencer can start tasks" }
        }
      }
    },

    "/api/collaborations/tasks/{id}/submit": {
      "patch": {
        "tags": ["Tasks"],
        "summary": "Submit task for review (influencer only)",
        "description": "Moves task from `in_progress` → `in_review`. Saves submission URL and note.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "submissionUrl": { "type": "string", "example": "https://instagram.com/p/abc123" },
                  "submissionNote": { "type": "string", "example": "Used the brand hashtag as discussed." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Task submitted for review" },
          "400": { "description": "Task must be in_progress to submit" },
          "403": { "description": "Only the influencer can submit tasks" }
        }
      }
    },

    "/api/collaborations/tasks/{id}/approve": {
      "patch": {
        "tags": ["Tasks"],
        "summary": "Approve a task (owner only)",
        "description": "Moves task from `in_review` → `Approved`. If all tasks approved, owner can then complete the collaboration.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": { "description": "Task approved" },
          "400": { "description": "Task must be in_review to approve" },
          "403": { "description": "Only the owner can approve tasks" }
        }
      }
    },

    "/api/collaborations/tasks/{id}/reject": {
      "patch": {
        "tags": ["Tasks"],
        "summary": "Reject task and send back for revision (owner only)",
        "description": "Moves task from `in_review` → `todo`. Influencer can resubmit.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reviewNote": { "type": "string", "example": "Please add the discount code in the caption." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Task sent back for revision" },
          "400": { "description": "Task must be in_review" },
          "403": { "description": "Only the owner can reject tasks" }
        }
      }
    },

    "/api/collaborations/tasks/{id}/reject-final": {
      "patch": {
        "tags": ["Tasks"],
        "summary": "Permanently reject a task (owner only)",
        "description": "Moves task to `rejected` — terminal state, no resubmission possible.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reviewNote": { "type": "string", "example": "Content does not match brand guidelines at all." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Task permanently rejected" },
          "400": { "description": "Task must be in_review" },
          "403": { "description": "Only the owner can reject tasks" }
        }
      }
    }

  }
}