{
  "name": "socialmedia-marketing-backend",
  "version": "1.0.0",
  "description": "Backend for Social Media Marketing App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "seed": "node seed2/index.js",
    "seed:low": "set SEED_COUNT=low&& node seed2/index.js",
    "seed:high": "set SEED_COUNT=high&& node seed2/index.js",
    "seed:verbose": "set SEED_VERBOSE=true&& node seed2/index.js",
    "docs:bundle": "npx redocly bundle docs/index.yaml --output swagger-bundled.json",
    "docs:validate": "redocly lint docs/index.yaml",
    "docs:preview": "redocly preview-docs docs/index.yaml",
    "docs:watch": "nodemon --watch docs --exec \"npm run docs:bundle\"",
    "prestart": "npm run docs:bundle"
  },
  "keywords": [
    "social-media",
    "marketing",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.6",
    "jest": "^30.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
